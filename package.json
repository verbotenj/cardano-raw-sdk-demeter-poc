{
  "name": "cardano-raw-sdk-demeter-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example application using the Demeter-enabled Cardano Raw SDK fork",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "quality": "npm run check && npm run test:proof && npm run audit:prod && npm run docs:verify",
    "docs:verify": "node scripts/verify-docs.mjs",
    "demo": "CUSTODY_MODE=mock tsx src/index.ts",
    "poc:mock": "CUSTODY_MODE=mock tsx src/index.ts",
    "poc:local": "CUSTODY_MODE=local tsx src/index.ts",
    "poc:fireblocks": "CUSTODY_MODE=fireblocks tsx src/index.ts",
    "proof:demeter": "npm run check && npm run test:proof && npm run poc:mock && npm run proof:demeter:live && npm run proof:chain",
    "proof:demeter:live": "tsx src/prove-demeter-readme.ts",
    "proof:chain": "tsx src/verify-on-chain.ts",
    "proof:verify": "tsx src/verify-governance-proof.ts",
    "test": "npm run test:proof",
    "test:proof": "npm run test:governance-proof && npm run test:on-chain-proof",
    "test:governance-proof": "tsx src/governance-proof.test.ts",
    "test:on-chain-proof": "tsx src/on-chain-proof.test.ts"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@fireblocks/ts-sdk": "^12.1.1",
    "bip39": "^3.1.0",
    "blakejs": "^1.2.1",
    "cardano-raw-sdk": "git+https://github.com/verbotenj/cardano-raw-sdk.git#411f8ecc00b78cbecd950fb53b2dbd9c492951ba",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
