{
  "name": "cardano-raw-sdk-demeter-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example application using the Demeter-enabled Cardano Raw SDK fork",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "poc:mock": "CUSTODY_MODE=mock tsx src/index.ts",
    "poc:fireblocks": "CUSTODY_MODE=fireblocks tsx src/index.ts"
  },
  "dependencies": {
    "@emurgo/cardano-serialization-lib-nodejs": "^15.0.3",
    "@fireblocks/ts-sdk": "^12.1.1",
    "bip39": "^3.1.0",
    "blakejs": "^1.2.1",
    "cardano-raw-sdk": "git+https://github.com/verbotenj/cardano-raw-sdk.git#main",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}
