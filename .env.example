# Beginner-safe defaults: Cardano Preview + read-only mock custody.
# Copy this file to .env.development. Never commit that private file.
CARDANO_NETWORK=Preview
# mock = no submission; local = mnemonic signing; fireblocks = Fireblocks signing.
CUSTODY_MODE=mock

# Required: create a Preview Blockfrost resource in Demeter and paste its values.
DEMETER_BLOCKFROST_URL=https://cardano-preview.blockfrost-m1.demeter.run
DEMETER_API_KEY=

# Required for mock mode. Use Preview test-wallet values only, never a mainnet wallet.
CARDANO_MNEMONIC=
CARDANO_ADDRESS_1=addr_test1...
CARDANO_ADDRESS_2=addr_test1...

# Optional advanced mode. Leave these empty while following the beginner guide.
FIREBLOCKS_API_USER_KEY=
FIREBLOCKS_API_USER_SECRET_KEY_PATH=
FIREBLOCKS_API_USER_SECRET_KEY=
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io
FIREBLOCKS_VAULT_ACCOUNT_ID=
RUN_LIVE_FIREBLOCKS=0

# 1 ADA = 1,000,000 lovelace. The tutorial defaults to a 2 ADA transaction.
LIVE_TRANSFER_LOVELACE=2000000

# Required only for local on-chain submission. Keep 0 for the read-only demo.
RUN_LIVE_LOCAL=0

# Optional: set to 1 to show detailed SDK logs while troubleshooting.
POC_VERBOSE=0

# Sanitized run logs and confirmed transaction receipts are written here.
POC_OUTPUT_DIR=output
